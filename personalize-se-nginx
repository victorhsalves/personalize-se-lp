server {
    server_name personalize-se.ilhasoftware.com www.personalize-se.ilhasoftware.com;

    # Logs específicos do projeto
    access_log /var/log/nginx/personalize-se.access.log;
    error_log  /var/log/nginx/personalize-se.error.log;

    # Ajustes básicos
    client_max_body_size 20M;
    charset utf-8;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;

        # Headers essenciais
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Evita cache estranho em LP
        proxy_cache_bypass $http_upgrade;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/personalize-se.ilhasoftware.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/personalize-se.ilhasoftware.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = personalize-se.ilhasoftware.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot
    listen 80;
    server_name personalize-se.ilhasoftware.com www.personalize-se.ilhasoftware.com;
    return 404; # managed by Certbot
}
